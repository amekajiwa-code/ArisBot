# ─── Discord ───────────────────────────────────────────────
# Bot token from the Discord Developer Portal (Bot tab → Reset/Copy Token).
# The bot only needs to be invited to your server with "Send Messages" permission.
# No privileged intents (Message Content / Presence) are required.
DISCORD_BOT_TOKEN=

# ─── Steam 동접자 알림 (optional) ──────────────────────────
# STEAM_ALERT_CHANNEL_ID 를 채우면 활성화. 비워두면 기능 꺼짐.
# 동접이 직전 알림값보다 THRESHOLD 이상 "증가"하고, 또한 현재값이
# MIN_COUNT 이상일 때만 SteamDB 링크가 담긴 임베드로 "돌파" 알림을 보냅니다.
# (감소 시엔 알림 없이 기준선만 조용히 내려갑니다.)
STEAM_ALERT_CHANNEL_ID=
STEAM_APP_ID=3088400
STEAM_GAME_NAME=Deadly Trick
STEAM_POLL_INTERVAL_SEC=600
STEAM_ALERT_THRESHOLD=25
STEAM_ALERT_MIN_COUNT=5

# ─── Twitch 카테고리 라이브 알림 (optional) ────────────────
# TWITCH_CLIENT_ID + TWITCH_CLIENT_SECRET 를 채우면 활성화. 비워두면 기능 꺼짐.
# Twitch 개발자 콘솔(https://dev.twitch.tv/console/apps)에서 앱 등록 → Client Type "Confidential"
# 로 만들면 ID/Secret 이 나온다. (OAuth Redirect URL 은 http://localhost 아무거나, 실제로 안 씀.)
# 지정 카테고리에 새 방송이 켜지면 해당 채널로 "{채널이름}님이 {카테고리} 방송중!" 임베드를 보낸다.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CATEGORY_NAME=Deadly Trick
# 알림 채널 (비우면 STEAM_ALERT_CHANNEL_ID 와 같은 채널 사용)
TWITCH_ALERT_CHANNEL_ID=
# 카테고리 이름으로 자동 조회되지만, 고정하고 싶으면 game_id 직접 지정 가능
TWITCH_GAME_ID=
TWITCH_POLL_INTERVAL_SEC=600
# 시청자 N명 이상인 방송만 알림 (0 = 전부)
TWITCH_ALERT_MIN_VIEWERS=50

# ─── 치지직(CHZZK) 카테고리 라이브 알림 (optional) ─────────
# CHZZK_CLIENT_ID + CHZZK_CLIENT_SECRET 를 채우면 활성화. 비워두면 기능 꺼짐.
# 치지직 개발자센터(https://developers.chzzk.naver.com)에서 앱 등록 후 발급.
# ⚠️ 공식 Open API엔 카테고리 필터가 없어, 전체 라이브 "시청자수 상위 CHZZK_MAX_PAGES×20개"만
#    훑어서 CHZZK_CATEGORY_ID 와 일치하는 방송을 찾는다. 시청자가 적은 소규모 카테고리는
#    상위권에 안 떠서 놓칠 수 있다(공식 API 한계).
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# 카테고리 식별자 — 치지직 카테고리 URL의 마지막 경로. 예: .../category/GAME/Deadly_Trick → Deadly_Trick
CHZZK_CATEGORY_ID=Deadly_Trick
CHZZK_CATEGORY_NAME=Deadly Trick
# 알림 채널 (비우면 STEAM_ALERT_CHANNEL_ID 와 같은 채널 사용)
CHZZK_ALERT_CHANNEL_ID=
CHZZK_POLL_INTERVAL_SEC=600
# 시청자 N명 이상인 방송만 알림 (0 = 전부)
CHZZK_ALERT_MIN_VIEWERS=50
# 매 폴링마다 훑을 라이브 페이지 수 (1페이지=20개). 클수록 더 깊게 찾지만 요청 늘어남.
CHZZK_MAX_PAGES=15
