{
  "name": "arisbot-notify",
  "version": "2.0.0",
  "description": "ArisBot — Discord notification bot: Steam player-count + Twitch/CHZZK category live alerts. Runs 24/7 on a cloud VM.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.4",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8"
  }
}
